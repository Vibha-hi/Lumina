{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/server.ts",
    "src/routes/**/*.tsx",
    "backend/src/server.ts",
    "backend/src/app.ts",
    "vite.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "backend/src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/routeTree.gen.ts"
  ]
}
