{
  "manifest_version": 3,
  "name": "LUMINA.AI Analyzer",
  "version": "1.0.0",
  "description": "Analyze social media posts before you publish to prevent professional and personal harm.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.reddit.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://lumina-ai-81zb.onrender.com/*"
      ],
      "js": [
        "auth-sync.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://lumina-0eyg.onrender.com/*",
    "https://lumina-ai-81zb.onrender.com/*"
  ]
}