{
  "manifest_version": 3,
  "name": "LUMINA.AI Analyzer",
  "version": "1.0.0",
  "description": "Analyze social media posts before you publish to prevent professional and personal harm.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.reddit.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:5173/*"
      ],
      "js": ["auth-sync.js"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://127.0.0.1:5000/*"
  ]
}
